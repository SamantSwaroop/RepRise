# ==============================================================================
# RepRise API — Production Environment Configuration
# Copy this file to .env.production on your production host
# ==============================================================================

# Server Port
PORT=4000
NODE_ENV=production

# Database Connection (PostgreSQL 16+)
# Replace host, user, password, and database with your production credentials
# Example: postgres://reprise_user:SuperSecurePassword123@db.yourdomain.com:5432/reprise_prod
DATABASE_URL=postgres://reprise:reprise_prod_password_change_me@postgres:5432/reprise

# JWT Cryptographic Secrets (Generate via: openssl rand -base64 48)
JWT_ACCESS_SECRET=replace_with_a_cryptographically_secure_random_string_min_48_chars
JWT_REFRESH_SECRET=replace_with_another_cryptographically_secure_random_string_min_48_chars
