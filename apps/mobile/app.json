{
  "expo": {
    "name": "RepRise",
    "slug": "reprise",
    "scheme": "reprise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#2E3440",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E3440"
    },
    "ios": {
      "bundleIdentifier": "com.samant6903.reprise",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "RepRise needs access to your photos to allow you to select a profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.samant6903.reprise",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E3440"
      },
      "permissions": [
        "android.permission.NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "RepRise needs access to your photos to allow you to select a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#88C0D0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "samant6903",
    "extra": {
      "eas": {
        "projectId": "40d48fac-fc18-4c4c-b19b-b7c38d745824"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/40d48fac-fc18-4c4c-b19b-b7c38d745824"
    }
  }
}
